# Example .env for Jarvis (DO NOT COMMIT secrets)
# Copy to server/.env and fill with your values (keep .env out of Git)

OPENAI_API_KEY=
# GITHUB app details (if using GitHub integration)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Put your GitHub app private key path or load it from your system secret manager
# Recommended (local dev): place `github-app.pem` one level above this repo and set:
# GITHUB_APP_PRIVATE_KEY_PATH=../github-app.pem
# Or set the PEM text directly in `GITHUB_APP_PRIVATE_KEY` with newline escapes (-----BEGIN...\n...)
GITHUB_APP_PRIVATE_KEY_PATH=

# Local mode to write artifacts to disk
JARVIS_WRITE_BACKEND=local

# Server port
PORT=3000
